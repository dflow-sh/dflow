{
  "$schema": "../dflow.schema.json",
  "name": "metabase",
  "summary": "Metabase analytics with PostgreSQL",
  "applications": [
    {
      "name": "metabase",
      "image": "metabase/metabase:v0.65.6.3",
      "port": 3000,
      "replicas": 1,
      "memory_mi": 2048,
      "route": { "public": true },
      "env": {
        "MB_DB_TYPE": "postgres",
        "JAVA_OPTS": "-Xmx1536m",
        "MB_DISABLE_LEGACY_STARTUP_ENCRYPTION": "true"
      },
      "secrets": {
        "MB_DB_HOST": { "service": "metabase-db", "field": "host" },
        "MB_DB_PORT": { "service": "metabase-db", "field": "port" },
        "MB_DB_USER": { "service": "metabase-db", "field": "username" },
        "MB_DB_PASS": { "service": "metabase-db", "field": "password" },
        "MB_DB_DBNAME": { "service": "metabase-db", "field": "database" },
        "MB_ENCRYPTION_SECRET_KEY": { "generate": true },
        "MB_SESSION_SECRET_KEY": { "generate": true }
      }
    }
  ],
  "services": [
    { "name": "metabase-db", "provider": "postgresql", "database": "metabaseappdb", "storage": "1Gi" }
  ]
}
