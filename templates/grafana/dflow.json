{
  "$schema": "../dflow.schema.json",
  "name": "grafana",
  "summary": "Grafana with PostgreSQL",
  "applications": [
    {
      "name": "grafana",
      "image": "grafana/grafana:13.3.2",
      "port": 3000,
      "replicas": 1,
      "memory_mi": 1024,
      "route": { "public": true },
      "volume": { "mount": "/var/lib/grafana", "size": "1Gi", "storage_class": "local-path" },
      "env": {
        "GF_SERVER_HTTP_PORT": "3000",
        "GF_SERVER_PROTOCOL": "http",
        "GF_DATABASE_TYPE": "postgres",
        "GF_DATABASE_SSL_MODE": "disable",
        "GF_SECURITY_ADMIN_USER": "admin",
        "GF_SECURITY_COOKIE_SECURE": "true",
        "GF_ANALYTICS_REPORTING_ENABLED": "false",
        "GF_ANALYTICS_CHECK_FOR_UPDATES": "false",
        "GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES": "false"
      },
      "secrets": {
        "GF_DATABASE_HOST": { "service": "grafana-db", "field": "host" },
        "GF_DATABASE_PORT": { "service": "grafana-db", "field": "port" },
        "GF_DATABASE_NAME": { "service": "grafana-db", "field": "database" },
        "GF_DATABASE_USER": { "service": "grafana-db", "field": "username" },
        "GF_DATABASE_PASSWORD": { "service": "grafana-db", "field": "password" },
        "GF_SECURITY_ADMIN_PASSWORD": { "generate": true },
        "GF_SECURITY_SECRET_KEY": { "generate": true }
      }
    }
  ],
  "services": [
    { "name": "grafana-db", "provider": "postgresql", "database": "grafana", "storage": "1Gi" }
  ]
}
